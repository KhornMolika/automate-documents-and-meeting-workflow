# ==========================================
# Root .gitignore — ACLEDA Document & Meeting Workflow Monorepo
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
token.json
client_secrets.json

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Runtime logs & storage
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
uploads/
exports/
tmp/
temp/

# Generated Chrome extension install folder
AUB-Meeting-Extension/

# UI design review artifacts
.taste-skill/

# Databases & local storage
*.db
*.db-journal
*.sqlite
*.sqlite3
test_aub_workflow.db
aub_workflow.db

# ------------------------------------------
# Python (Backend & Speech Service)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
test-results/
playwright-report/
blob-report/

# ------------------------------------------
# Node.js & Web (Frontend & Extension)
# ------------------------------------------
node_modules/
.pnp
.pnp.js

# Nuxt 3 & Nitro build output
.nuxt/
.output/
.nitro/
dist/

# WXT Chrome Extension build output
.wxt/
*.zip

# ------------------------------------------
# AI Models & Audio Cache
# ------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
speech-service/models/*
!speech-service/models/.gitkeep

# Audio raw dumps
*.pcm
*.wav
*.mp3
*.flac
*.m4a
