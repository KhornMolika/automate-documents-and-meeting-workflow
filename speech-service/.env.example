# Google Gemini API key used for Khmer transcription.
# Create one in Google AI Studio. The key is read by speech-service/service.py.
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Fallback used when the transcription model is rate-limited or unavailable.
GEMINI_TRANSCRIBE_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
# Send one Gemini request per this many seconds of audio (not per VAD segment).
GEMINI_TRANSCRIBE_CHUNK_SECONDS=120
GEMINI_TIMEOUT_SECONDS=120
